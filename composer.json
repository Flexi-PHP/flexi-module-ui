{
  "name": "flexi/flexi-module-ui",
  "description": "UI rendering module for Flexi Framework",
  "version": "2.0.0",
  "type": "flexi-module",
  "license": "MIT",
  "keywords": [
    "flexi",
    "module",
    "ui",
    "template",
    "rendering"
  ],
  "authors": [
    {
      "name": "Carlos Batista",
      "email": "info@carlosbatista.dev",
      "homepage": "https://carlosbatista.dev"
    }
  ],
  "require": {
    "php": ">=7.4",
    "flexi/contracts": "^5.2.1"
  },
  "autoload": {
    "psr-4": {
      "Flexi\\Modules\\Ui\\": ""
    }
  },
  "extra": {
    "flexi": {
      "module-name": "Ui",
      "module-type": "infrastructure",
      "config-files": [
        "Config/services.json"
      ],
      "provides": [
        "template-engine",
        "html-rendering",
        "ui-components"
      ],
      "schema-version": 1,
      "compatibility": {
        "core": "^3.2"
      }
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Flexi\\Modules\\Ui\\Tests\\": "tests/"
    }
  },
  "require-dev": {
    "phpunit/phpunit": "^9.6"
  }
}
